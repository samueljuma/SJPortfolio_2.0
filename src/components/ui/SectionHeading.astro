---
import Eyebrow from './Eyebrow.astro';

/** Section intro: eyebrow + h2 on the left, optional lede on the right. */
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lede?: string;
}

const { id, eyebrow, title, lede } = Astro.props;
---

<div class="flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
  <div class="flex flex-col gap-4">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2
      id={id}
      class="font-display text-[32px] leading-[1.12] font-extrabold tracking-[-0.02em] text-balance md:text-5xl"
    >
      {title}
    </h2>
  </div>
  {lede && <p class="text-muted max-w-[420px] text-base leading-relaxed md:text-[17px]">{lede}</p>}
</div>
