---
import { Image } from 'astro:assets';

import type { Project } from '../../data/site';
import Icon from './Icon.astro';
import Tag from './Tag.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="border-line bg-surface hover:border-accent/40 group flex flex-col overflow-hidden rounded-3xl border transition-all duration-300 hover:-translate-y-1"
  data-reveal
>
  <div class="overflow-hidden">
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[400, 600, 900]}
      sizes="(min-width: 768px) 588px, 100vw"
      class="aspect-[588/287] h-auto w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3.5 px-5 pt-5 pb-6 md:px-7 md:pt-[26px] md:pb-7">
    <p class="text-accent font-mono text-xs font-medium tracking-[0.08em] uppercase">
      {project.industry}
    </p>
    <h3 class="font-display text-2xl font-bold tracking-[-0.01em]">{project.title}</h3>
    <p class="text-muted text-[15.5px] leading-relaxed">{project.summary}</p>
    <ul class="flex flex-wrap gap-2" aria-label="Tech used">
      {
        project.tags.map((tag) => (
          <li>
            <Tag>{tag}</Tag>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-1.5">
      {
        project.caseStudy && (
          <a
            href={`/work/${project.slug}`}
            class="hover:text-accent inline-flex items-center gap-2 text-[15px] font-semibold transition-colors"
          >
            Read case study <Icon name="arrow-right" size={16} />
            <span class="sr-only">: {project.title}</span>
          </a>
        )
      }
      <a
        href={project.playStore}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-text inline-flex items-center gap-2 text-[15px] font-medium transition-colors"
      >
        Google Play <Icon name="arrow-up-right" size={15} /><span class="sr-only"
          >: {project.title}</span
        >
      </a>
    </div>
  </div>
</article>
