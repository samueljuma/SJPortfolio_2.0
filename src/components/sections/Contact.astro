---
import { contact, site, socials } from '../../data/site';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import IconBadge from '../ui/IconBadge.astro';

const byIcon = (icon: string) => socials.find((s) => s.icon === icon)!;
const channels = [
  { icon: 'mail' as const, label: 'Email', value: site.email, href: `mailto:${site.email}` },
  {
    icon: 'whatsapp' as const,
    label: 'WhatsApp',
    value: byIcon('whatsapp').handle,
    href: byIcon('whatsapp').href,
  },
  {
    icon: 'linkedin' as const,
    label: 'LinkedIn',
    value: byIcon('linkedin').handle,
    href: byIcon('linkedin').href,
  },
];

const field =
  'border-line bg-surface placeholder:text-subtle focus:border-accent focus:ring-accent/25 w-full rounded-xl border px-4 py-3.5 text-[15px] transition-colors outline-none focus:ring-4';
const label = 'text-muted text-sm font-medium';
---

<section id="contact" class="pt-2 pb-14 md:pt-10 md:pb-[120px]" aria-labelledby="contact-title">
  <Container>
    <div
      class="border-accent/30 from-accent-soft to-surface via-surface grid gap-10 overflow-hidden rounded-[26px] border bg-linear-to-br via-60% px-[22px] pt-[30px] pb-6 md:rounded-[32px] md:p-16 lg:grid-cols-[1fr_500px] lg:gap-16"
      data-reveal
    >
      <div class="flex flex-col gap-5 md:gap-[22px]">
        <Eyebrow>{contact.eyebrow}</Eyebrow>
        <h2
          id="contact-title"
          class="font-display text-[30px] leading-[1.1] font-extrabold tracking-[-0.02em] md:text-5xl lg:text-[44px]"
        >
          <span class="xl:whitespace-nowrap">{contact.title}</span>
          <span class="text-accent lg:block">{contact.titleAccent}</span>
        </h2>
        <p class="text-muted text-[15.5px] leading-relaxed md:text-[17px]">{contact.lede}</p>
        <ul class="flex flex-col gap-3 md:pt-2">
          {
            channels.map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.icon === 'mail' ? undefined : '_blank'}
                  rel={c.icon === 'mail' ? undefined : 'noopener noreferrer'}
                  class="border-line bg-ink/55 hover:border-accent/50 group flex items-center gap-3.5 rounded-[14px] border py-3 pr-[18px] pl-3.5 transition-colors"
                >
                  <IconBadge name={c.icon} size="sm" />
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="text-subtle text-xs">{c.label}</span>
                    <span class="truncate text-[15px] font-semibold">{c.value}</span>
                  </span>
                  <Icon
                    name="arrow-up-right"
                    size={18}
                    class="text-muted group-hover:text-accent transition-colors"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        action={contact.formAction}
        method="POST"
        class="border-line bg-ink flex flex-col gap-[18px] rounded-[18px] border p-[18px] md:rounded-3xl md:p-8"
      >
        <h3 class="font-display text-xl font-bold">{contact.formTitle}</h3>
        <input type="hidden" name="_subject" value={contact.formSubject} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={contact.thanksUrl} />
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        <div class="flex flex-col gap-2">
          <label for="contact-name" class={label}>{contact.fields.name.label}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder={contact.fields.name.placeholder}
            class={field}
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="contact-email" class={label}>{contact.fields.email.label}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={contact.fields.email.placeholder}
            class={field}
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="contact-message" class={label}>{contact.fields.message.label}</label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="5"
            placeholder={contact.fields.message.placeholder}
            class:list={[field, 'min-h-[130px] resize-y']}></textarea>
        </div>
        <button
          type="submit"
          class="bg-accent text-accent-ink hover:shadow-accent/30 flex items-center justify-center gap-2.5 rounded-xl px-[22px] py-3.5 font-semibold transition-all hover:-translate-y-0.5 hover:shadow-[0_14px_36px]"
        >
          {contact.submit}
          <Icon name="arrow-right" size={18} />
        </button>
      </form>
    </div>
  </Container>
</section>
