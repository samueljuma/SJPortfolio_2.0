---
import { about } from '../../data/site';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import IconBadge from '../ui/IconBadge.astro';

const i = about.title.indexOf(about.highlight);
---

<section
  id="about"
  class="border-line bg-surface/50 border-y py-16 md:py-[120px]"
  aria-labelledby="about-title"
>
  <Container class="grid items-center gap-10 lg:grid-cols-[1fr_520px] lg:gap-20">
    <div class="flex flex-col gap-5 md:gap-[22px]" data-reveal>
      <Eyebrow>{about.eyebrow}</Eyebrow>
      <h2
        id="about-title"
        class="font-display text-[32px] leading-[1.12] font-extrabold tracking-[-0.02em] text-balance md:text-[44px]"
      >
        {about.title.slice(0, i)}<span class="text-accent">{about.highlight}</span>
      </h2>
      {about.body.map((p) => <p class="text-muted text-base leading-[1.7] md:text-[17px]">{p}</p>)}
    </div>

    <ul class="flex flex-col gap-3 md:gap-4">
      {
        about.principles.map((item) => (
          <li
            class="border-line bg-ink flex gap-3.5 rounded-2xl border p-4 md:gap-[18px] md:rounded-[18px] md:px-[22px] md:py-5"
            data-reveal
          >
            <IconBadge name={item.icon} />
            <div class="flex flex-col gap-1.5">
              <h3 class="font-display text-base font-bold md:text-[17px]">{item.title}</h3>
              <p class="text-muted text-sm leading-[1.55] md:text-[14.5px]">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
