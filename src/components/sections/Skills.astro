---
import { skills } from '../../data/site';
import Container from '../ui/Container.astro';
import IconBadge from '../ui/IconBadge.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';
---

<section
  id="skills"
  class="border-line bg-surface/50 border-y py-16 md:py-[120px]"
  aria-labelledby="skills-title"
>
  <Container class="flex flex-col gap-10 md:gap-14">
    <SectionHeading
      id="skills-title"
      eyebrow={skills.eyebrow}
      title={skills.title}
      lede={skills.lede}
    />
    <ul class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
      {
        skills.groups.map((group) => (
          <li
            class="border-line bg-ink flex flex-col gap-[18px] rounded-[18px] border p-[18px] md:rounded-[22px] md:p-7"
            data-reveal
          >
            <div class="flex items-center gap-3.5">
              <IconBadge name={group.icon} />
              <h3 class="font-display text-base font-bold md:text-[19px]">{group.title}</h3>
            </div>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li>
                  <Tag>{item}</Tag>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
