---
import { site } from '../../data/site';
import Monogram from '../ui/Monogram.astro';
import SocialLinks from '../ui/SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div
    class="max-w-page mx-auto flex flex-col items-center gap-5 px-5 pt-8 pb-10 md:flex-row md:justify-between md:px-10"
  >
    <div class="flex items-center gap-3.5">
      <Monogram class="size-8 text-[13px]" />
      <p class="text-subtle text-sm">© {year} {site.name} · {site.role}</p>
    </div>
    <SocialLinks />
  </div>
</footer>
