---
import { services } from '../../data/site';
import Container from '../ui/Container.astro';
import IconBadge from '../ui/IconBadge.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="services" class="py-16 md:py-[120px]" aria-labelledby="services-title">
  <Container class="flex flex-col gap-10 md:gap-14">
    <SectionHeading
      id="services-title"
      eyebrow={services.eyebrow}
      title={services.title}
      lede={services.lede}
    />
    <ol class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-4">
      {
        services.items.map((item, i) => (
          <li
            class="border-line bg-surface flex flex-col gap-4 rounded-[22px] border px-[26px] pt-[26px] pb-[30px]"
            data-reveal
          >
            <div class="flex items-center justify-between">
              <IconBadge name={item.icon} />
              <span class="text-subtle font-mono text-[13px] font-medium" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="font-display text-[19px] font-bold">{item.title}</h3>
            <p class="text-muted text-[15px] leading-relaxed">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
